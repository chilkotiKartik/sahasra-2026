# ─── SAHASRA client (Expo) environment ───────────────────────────────────────
# EXPO_PUBLIC_* vars are inlined into the app bundle at build time. For EAS
# builds these MUST also be declared in eas.json's per-profile `env` block —
# a value that works in `expo start` does NOT automatically carry into an EAS
# build (this is the #1 cause of "works locally, broken after deploy").

# Backend API origin (no trailing slash). Leave unset for local web dev (auto
# -detected). REQUIRED for any device/EAS build — point it at your deployed API.
EXPO_PUBLIC_API_URL=https://your-sahasra-api.example.com

# Sentry DSN (Phase 8). Leave empty to disable crash reporting entirely.
EXPO_PUBLIC_SENTRY_DSN=

# ─── server (kept out of the client bundle) ──────────────────────────────────
# JWT secrets — set these in production so tokens survive server restarts.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# LLM keys already used by the legacy intelligence routes.
OPENAI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
