{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "web": "npx tsx server/index.ts",
    "app": "npx expo start",
    "dev": "npx tsx server/index.ts",
    "postinstall": "patch-package",
    "expo:dev": "npx expo start --localhost",
    "server:dev": "npx tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --bundle --format=esm --outfile=build/index.mjs --external:pg-native --external:cpu-features --banner:js=\"import{createRequire as __cr}from'module';import{fileURLToPath as __ffu}from'url';import{dirname as __ddn}from'path';const require=__cr(import.meta.url);const __filename=__ffu(import.meta.url);const __dirname=__ddn(__filename);\"",
    "server:prod": "NODE_ENV=production node build/index.mjs",
    "build": "npm run server:build",
    "catalyst:build": "npm run catalyst:client:build && npm run server:build",
    "catalyst:start": "NODE_ENV=production node build/index.mjs",
    "catalyst:client:build": "cd web && npm install && npm run build",
    "db:push": "drizzle-kit push",
    "prepare:deploy": "node scripts/prepare-deploy.js",
    "start": "node build/index.mjs",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.2.0",
    "@simplewebauthn/server": "^10.0.1",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.83.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@ungap/structured-clone": "^1.3.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1",
    "esbuild": "^0.28.0",
    "expo": "~54.0.27",
    "expo-av": "^16.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.11",
    "expo-font": "~14.0.10",
    "expo-glass-effect": "~0.1.4",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.9",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.17",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-server-sdk": "^6.1.0",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "express": "^5.2.1",
    "haversine-distance": "^1.2.4",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "lucide-react-native": "^1.26.0",
    "openai": "^6.37.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pg": "^8.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "^1.20.6",
    "react-native-maps": "^1.18.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "15.12.1",
    "react-native-volume-manager": "^2.0.8",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "ws": "^8.20.0",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/react": "~19.1.10",
    "@types/ws": "^8.18.1",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
